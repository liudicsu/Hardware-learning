# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch space for local experiments
.scratch/

# simulation build products and outputs
tools/sim/build/
tools/sim/out/
# written by examples/month-1/python-terminal/log.py
examples/**/measurements.json
# the ESP32 core also exports binaries into <sketch>/build/
examples/**/build/

# Python caches
__pycache__/
*.pyc

# pixi environments (examples/month-4, examples/month-5: `pixi install`); the lock files are not committed
.pixi/
examples/**/pixi.lock

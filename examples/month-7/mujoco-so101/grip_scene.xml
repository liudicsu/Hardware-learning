<mujoco model="grip_cube">
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10" gravity="0 0 -9.81"/>
  <default>
    <geom friction="1 0.005 0.0005" solref="0.02 1" solimp="0.9 0.95 0.001 0.5 2" condim="3"/>
  </default>
  <worldbody>
    <light pos="0 0 1"/>
    <geom name="floor" type="plane" size="0.5 0.5 0.01" rgba="0.85 0.85 0.85 1" friction="0.4 0.005 0.0001"/>
    <body name="lift" pos="0 0 0.05">
      <inertial pos="0 0 0" mass="0.2" diaginertia="0.001 0.001 0.001"/>
      <joint name="lift" type="slide" axis="0 0 1" range="0 0.15"/>
      <geom name="palm" type="box" size="0.05 0.03 0.005" pos="0 0 0.025" rgba="0.3 0.3 0.3 1" contype="0" conaffinity="0" mass="0.05"/>
      <body name="left_jaw" pos="-0.045 0 0">
        <joint name="left" type="slide" axis="1 0 0" range="-0.02 0.04"/>
        <geom name="left_g" type="box" size="0.008 0.025 0.02" rgba="0.2 0.4 0.8 1" friction="1.5 0.005 0.0005" mass="0.05" solref="0.01 1" priority="1"/>
      </body>
      <body name="right_jaw" pos="0.045 0 0">
        <joint name="right" type="slide" axis="1 0 0" range="-0.04 0.02"/>
        <geom name="right_g" type="box" size="0.008 0.025 0.02" rgba="0.2 0.4 0.8 1" friction="1.5 0.005 0.0005" mass="0.05" solref="0.01 1" priority="1"/>
      </body>
    </body>
    <body name="cube" pos="0 0 0.05">
      <freejoint name="cube_free"/>
      <!-- Default mass 0.08 kg; grip_sweep.py overrides body mass to CUBE_MASS=0.15 at runtime. -->
      <geom name="cube_geom" type="box" size="0.015 0.015 0.015" mass="0.08" rgba="0.9 0.3 0.1 1" friction="1.2 0.005 0.0005"/>
    </body>
  </worldbody>
  <actuator>
    <position name="lift_act" joint="lift" kp="400" kv="40" ctrlrange="0 0.15"/>
    <position name="left_act" joint="left" kp="300" kv="30" ctrlrange="-0.02 0.04"/>
    <position name="right_act" joint="right" kp="300" kv="30" ctrlrange="-0.04 0.02"/>
  </actuator>
</mujoco>

<?xml version="1.0"?>
<!-- m4bot for Gazebo: the Lesson 3 description plus what only a simulator needs:
     friction, a lidar, a camera, a diff-drive plugin and joint plugins. -->
<robot name="m4bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find m4_description)/urdf/robot.urdf.xacro"/>

  <!-- the caster ball should slide, the wheels should grip -->
  <gazebo reference="caster_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>
  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- 2D lidar: 360 beams, 10 Hz. min 0.20 m so the beams that hit our own mast are dropped. -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>   <!-- the frame_id in every LaserScan -->
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.12414</max_angle>   <!-- pi - 1 degree: 360 beams, exactly 1 degree apart -->
          </horizontal>
        </scan>
        <range>
          <min>0.20</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- camera: looks along camera_link's x axis; images are stamped with the optical frame -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <camera>
        <camera_info_topic>camera/camera_info</camera_info_topic>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <!-- drive: listens on cmd_vel, publishes odom and the odom -> base_footprint transform.
         Lesson 5 replaces this plugin with ros2_control. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <!-- report every joint's position, so robot_state_publisher can publish the TF -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
    <!-- hold the pan-tilt head where it is told (otherwise gravity tips the camera over) -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>pan_joint</joint_name>
      <topic>pan_cmd</topic>
      <p_gain>2.0</p_gain>
      <d_gain>0.05</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>tilt_joint</joint_name>
      <topic>tilt_cmd</topic>
      <p_gain>2.0</p_gain>
      <d_gain>0.05</d_gain>
    </plugin>
  </gazebo>

</robot>

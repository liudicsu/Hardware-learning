<?xml version="1.0"?>
<!-- What every simulated m4bot needs, whoever drives the wheels: friction, a lidar and a camera.
     Included by m4bot_gz.urdf.xacro (this lesson) and by Lesson 5's ros2_control description. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- the caster ball should slide, the wheels should grip -->
  <gazebo reference="caster_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>
  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- 2D lidar: 360 beams, 10 Hz. min 0.20 m so the beams that hit our own mast are dropped. -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>   <!-- the frame_id in every LaserScan -->
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.12414</max_angle>   <!-- pi - 1 degree: 360 beams, exactly 1 degree apart -->
          </horizontal>
        </scan>
        <range>
          <min>0.20</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- camera: looks along camera_link's x axis; images are stamped with the optical frame -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <camera>
        <camera_info_topic>camera/camera_info</camera_info_topic>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>

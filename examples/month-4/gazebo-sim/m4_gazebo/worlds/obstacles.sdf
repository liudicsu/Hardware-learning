<?xml version="1.0"?>
<!-- A 6 m x 6 m walled room with three obstacles. Everything is defined here,
     so the world loads without downloading models. -->
<sdf version="1.9">
  <world name="obstacles">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- four walls, 0.1 m thick, 0.5 m high; inner faces at x = +-2.95 and y = +-2.95 -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north_c"><pose>3 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.0 0.5</size></box></geometry></collision>
        <visual name="north_v"><pose>3 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.0 0.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
        <collision name="south_c"><pose>-3 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.0 0.5</size></box></geometry></collision>
        <visual name="south_v"><pose>-3 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.0 0.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
        <collision name="west_c"><pose>0 3 0.25 0 0 0</pose><geometry><box><size>6.1 0.1 0.5</size></box></geometry></collision>
        <visual name="west_v"><pose>0 3 0.25 0 0 0</pose><geometry><box><size>6.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
        <collision name="east_c"><pose>0 -3 0.25 0 0 0</pose><geometry><box><size>6.1 0.1 0.5</size></box></geometry></collision>
        <visual name="east_v"><pose>0 -3 0.25 0 0 0</pose><geometry><box><size>6.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <!-- straight ahead of the robot: a red box, front face at x = 1.8 -->
    <model name="red_box">
      <static>true</static>
      <pose>2.0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- to the front right: a blue pillar -->
    <model name="blue_pillar">
      <static>true</static>
      <pose>1.0 -1.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- behind on the left: a long green block -->
    <model name="green_block">
      <static>true</static>
      <pose>-1.5 1.5 0.2 0 0 0.6</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.3 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.3 0.4</size></box></geometry>
          <material><ambient>0.1 0.6 0.2 1</ambient><diffuse>0.1 0.6 0.2 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
